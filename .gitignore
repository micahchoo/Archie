# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─────────────────────────────────────────────────────────────
# Build output / generated
# ─────────────────────────────────────────────────────────────
dist/
# The two PUBLISHED embed trees are tracked artifacts, not build scratch — un-ignore them so a
# rebuild's new content-hashed chunks appear in `git status` instead of silently vanishing from the
# tree (that is how a8e228a shipped a root dist/ whose entry 404s on every chunk it imports).
!/dist/
!/packages/archie-viewer/dist/
build/
# Onboarding tutorial decks, synced from docs/learn by apps/studio/scripts/sync-learn.mjs
# (canonical source is docs/learn; this copy is a build artifact).
apps/studio/public/learn/
gh-pages-dist/
.astro/
.svelte-kit/
.vite/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Caches
# ─────────────────────────────────────────────────────────────
.cache/
.turbo/
.eslintcache
node-compile-cache/
v8-compile-cache-*/
.foxhound/

# ─────────────────────────────────────────────────────────────
# Test / coverage / browser-runner droppings
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright-artifacts-*/
playwright_chromiumdev_profile-*/

# ─────────────────────────────────────────────────────────────
# Logs (keep the deliberately-tracked deps-index promotion log)
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
!.claude/.deps-index/promote.log

# ─────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────────────────────
# Shell-redirect residue (accidental `cmd > --output`-style typos)
# ─────────────────────────────────────────────────────────────
/--output

# ─────────────────────────────────────────────────────────────
# One-shot analysis dumps — no generator script lives in this repo;
# regenerate with whatever external tool produced it, never commit the output.
# ─────────────────────────────────────────────────────────────
/anti-pattern-report.txt

# ─────────────────────────────────────────────────────────────
# Editor / OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# ─────────────────────────────────────────────────────────────
# Design working scratch — source assets stay tracked
# (design/fonts/ faces + licenses, design/*.html references);
# session droppings are ignored. Convention: `_`-prefixed names
# are throwaway (build logs, screenshots, capture scripts).
# ─────────────────────────────────────────────────────────────
design/_*

# Session scratch — throwaway analysis maps, never committed.
.scratch/

# ─────────────────────────────────────────────────────────────
# Project-local, intentionally untracked (do not commit)
# ─────────────────────────────────────────────────────────────
# bidar example — removed from Studio examples, kept locally (2026-06-09)
apps/studio/src/bidar.ts
scripts/import-bidar.mjs
docs/screenshots/auto/viewer-bidar.desktop.png

# Prior-art reference clones. CLAUDE.md sanctions `Archie/Prior Art` as a location for them
# (alongside the siblings at Annotators/Image/), and they are NESTED GIT REPOS — `freecut` alone is
# 52MB with its own .git. Committing one would add a broken half-submodule, not a directory.
# Reference material, cloned per machine; never repo content.
Prior Art/
