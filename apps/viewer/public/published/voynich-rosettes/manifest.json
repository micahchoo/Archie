          "label": {
            "none": [
              "Cipher reading"
            ]
          },
          "summary": {
            "none": [
              "The glyphs encode a real language through a cipher or steganographic scheme — the working assumption of the professional cryptanalysts (Currier, the Friedmans, Tiltman) who studied the manuscript."
            ]
