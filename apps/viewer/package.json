{
  "name": "@archie/viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Viewer — the published static site built by Studio's publish step. Astro + Svelte islands (ADR-0002 / Q-2). Adopts annomea's 3-state pane + popup/drawer in Phase 2. Read-only. Phase 0 = boundary shell.",
  "license": "GPL-3.0-only",
  "scripts": {
    "gen": "vite-node scripts/gen-published.mts",
    "dev": "astro dev",
    "predev": "vite-node scripts/gen-published.mts",
    "build": "astro build",
    "prebuild": "vite-node scripts/gen-published.mts",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check",
    "precheck:svelte": "astro sync",
    "check:svelte": "svelte-check --workspace . --fail-on-warnings",
    "pretypecheck": "astro sync",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@annotorious/openseadragon": "^3.8.2",
    "@annotorious/plugin-tools": "^1.6.0",
    "@render/core": "workspace:*",
    "@render/svelte": "workspace:*",
    "fflate": "^0.8.2",
    "isomorphic-dompurify": "^3.18.0",
    "minisearch": "^7.2.0",
    "openseadragon": "^5.0.1",
    "snarkdown": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/svelte": "^8.1.2",
    "@playwright/test": "1.60.0",
    "astro": "^6.4.6",
    "happy-dom": "^20.9.0",
    "svelte": "^5.15.0",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.3",
    "vite-node": "^6.0.0"
  }
}
